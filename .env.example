# ==========================================
# Windows Log-Based Browser Hijack Detector
# Environment Configuration Template
# ==========================================
# Copy this file to .env and fill in your actual credentials/configuration.
# NEVER commit .env to version control!

# ------------------------------------------
# 1. AWS Account & Provider Configuration
# ------------------------------------------
# Target AWS region for deployment (e.g. us-east-1, us-west-2, ap-south-1)
AWS_REGION=us-east-1

# Target AWS Account ID (12-digit number, e.g. 123456789012)
AWS_ACCOUNT_ID=

# Deployment environment: dev | staging | prod
ENVIRONMENT=dev

# Project naming prefix for cloud resources
PROJECT_NAME=hijack-detector

# AWS Credentials (if deploying via CLI / Terraform locally and not using ~/.aws/credentials or IAM Identity Center)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ------------------------------------------
# 2. Alerting & Notification
# ------------------------------------------
# Admin email to receive High-severity alerts and device silence notifications via Amazon SNS
ALERT_EMAIL=admin@example.com

# (Optional) Telegram alerts for High-severity incidents
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ------------------------------------------
# 3. Agent Endpoint Configuration
# ------------------------------------------
# Identifier for the monitored endpoint (e.g., PC-LAB-01, DESKTOP-OFFICE)
DEVICE_ID=PC-LAB-01

# The API Gateway HTTPS endpoint URL (obtained after running terraform apply in cloud/terraform)
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com
API_ENDPOINT=

# Device API Key generated during device registration in the dashboard or via CLI
# (The raw secret is stored only on the agent; SHA-256 hash is kept in DynamoDB)
API_KEY=

# ------------------------------------------
# 4. Standalone / Local Agent Mode
# ------------------------------------------
# Set to true to run the agent fully offline with local rule evaluation and SQLite storage
STANDALONE_MODE=false

# ------------------------------------------
# 5. Cloud Resources (Auto-populated by Terraform outputs)
# ------------------------------------------
# S3_RAW_BUCKET=hijackdet-dev-rawlogs-<account-id>
# S3_CONFIG_BUCKET=hijackdet-dev-config-<account-id>
# DYNAMODB_ALERTS_TABLE=hijackdet-dev-alerts
# DYNAMODB_DEVICES_TABLE=hijackdet-dev-devices
# DYNAMODB_HISTORY_TABLE=hijackdet-dev-event-history
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
